<html><head><meta charset="utf-8"><style>{{ css }}</style></head>
<body>
{% include "_cover.j2" %}
<div class="toc"><h2>Contents (TOC)</h2><ol>{% for s in doc.sections %}<li>{{ s.heading }}</li>{% endfor %}<li>About the author</li></ol></div>
